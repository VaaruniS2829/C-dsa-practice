#include <stdio.h>
#define MAX 10

struct PriorityQueue {
    int data;
    int priority;
};

struct PriorityQueue pq[MAX];
int size = 0;

/* Insert element */
void insert() {
    int value, pr;
    if (size == MAX) {
        printf("Priority Queue is Full\n");
        return;
    }

    printf("Enter value: ");
    scanf("%d", &value);
    printf("Enter priority: ");
    scanf("%d", &pr);

    pq[size].data = value;
    pq[size].priority = pr;
    size++;
}

/* Delete highest priority element */
void delete() {
    if (size == 0) {
        printf("Priority Queue is Empty\n");
        return;
    }

    int i, pos = 0;
    for (i = 1; i < size; i++) {
        if (pq[i].priority > pq[pos].priority) {
            pos = i;
        }
    }

    printf("Deleted element: %d (Priority %d)\n",
           pq[pos].data, pq[pos].priority);

    for (i = pos; i < size - 1; i++) {
        pq[i] = pq[i + 1];
    }
    size--;
}

/* Display elements */
void display() {
    if (size == 0) {
        printf("Priority Queue is Empty\n");
        return;
    }

    printf("Value\tPriority\n");
    for (int i = 0; i < size; i++) {
        printf("%d\t%d\n", pq[i].data, pq[i].priority);
    }
}

/* Main function */
int main() {
    int choice;
    while (1) {
        printf("\n--- Priority Queue Menu ---\n");
        printf("1. Insert\n");
        printf("2. Delete\n");
        printf("3. Display\n");
        printf("4. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
        case 1:
            insert();
            break;
        case 2:
            delete();
            break;
        case 3:
            display();
            break;
        case 4:
            return 0;
        default:
            printf("Invalid choice\n");
        }
    }
}
